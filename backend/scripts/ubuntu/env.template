# Rollladen Monitor Ubuntu Environment File Template
# Pfad: /etc/rollladen-monitor.env (chmod 0600 root:rollladen)
# Kopiert von: backend/scripts/ubuntu/env.template
# Alle Variablen OHNE Leerzeichen um Gleichheitszeichen!

# ===== Node / Express =====
PORT=3006
HOST=0.0.0.0
NODE_ENV=production
TZ=Europe/Berlin

# ===== Datenbank (Postgres extern) =====
# AUS .env WINDOWS KOPIEREN!
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DB

# ===== JWT / Auth =====
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS_DIFFERENT

# ===== Basic Auth (Monitor /display) =====
MONITOR_HTTP_USER=monitor
MONITOR_HTTP_PASSWORD=CHANGE_ME_PASSWORD_FROM_WINDOWS
MONITOR_ADMIN_KEY=CHANGE_ME_FROM_WINDOWS

# ===== Shopify =====
SHOPIFY_STORE_URL=rollladenwelt.myshopify.com
FRONTEND_URL=https://rollladenwelt.myshopify.com
SHOPIFY_API_KEY=CHANGE_ME_IF_USED
SHOPIFY_API_SECRET=CHANGE_ME_IF_USED
SHOPIFY_ADMIN_TOKEN=CHANGE_ME_IF_USED

# ===== Slack Integration =====
# AUS .env WINDOWS KOPIEREN!
SLACK_BOT_TOKEN=xoxb-CHANGE_ME
SLACK_LIST_ID=CHANGE_ME
SLACK_MATERIAL_LIST_ID=CHANGE_ME
SLACK_MATERIAL_ASSIGNEE=CHANGE_ME

# ===== Slack Safe Mode (WICHTIG! WÄHREND PARALLELTEST AUF 1 BLEIBEN!) =====
# 1 = Ubuntu darf NICHTS auf Slack schreiben (Nur Lesen). Max Sicherheit während Testphase!
# Nach Cutover auf 0 setzen, damit Slack Schreibzugriffe (Status, Material) wieder gehen.
SAFE_MODE_SLACK=1
SLACK_READONLY=1

# ===== Direktdruck Linux =====
# Chromium Headless für PDF-Generierung:
DIRECT_PRINT_CHROMIUM_EXE=/usr/bin/chromium-browser

# CUPS Druck:
DIRECT_PRINT_LP_EXE=/usr/bin/lp
DIRECT_PRINT_LPSTAT_EXE=/usr/bin/lpstat

# CUPS Druckername (MUSS GENAU so heißen wie lpstat -p Ausgabe!):
# Bsp nach lpadmin Setup: Brother-QL-1110NWB
DIRECT_PRINT_PRINTER=CHANGE_ME_CUPS_QUEUE_NAME

# ===== Abwärtskompatibel Windows-only (können auf Ubuntu leer bleiben) =====
DIRECT_PRINT_EDGE_EXE=
DIRECT_PRINT_SUMATRA_EXE=

# ===== Monitor Base URL (für Links in E-Mails/Labels) =====
# WÄHREND TEST: Test-Subdomain, nach Cutover: LIVE!
DISPLAY_BASE_URL=https://monitor-test.rollladenwelt.de/display
