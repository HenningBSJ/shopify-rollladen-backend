{% assign order_name = order.name %}
{% assign order_number = order.order_number %}
{% assign created_at = order.created_at %}
{% assign customer = order.customer %}
{% assign line_items = order.line_items %}
{% assign tax_lines = order.tax_lines %}
{% assign shipping_price = order.shipping_price %}
{% if order.shipping_address %}{% assign shipping_address = order.shipping_address %}{% endif %}
{% if order.billing_address %}{% assign billing_address = order.billing_address %}{% endif %}
{% assign order_raw = order_name | default: order_number | default: '' %}
{% assign invoice_digits = '' %}{% assign chars = order_raw | split: '' %}{% for c in chars %}{% case c %}{% when '0' or '1' or '2' or '3' or '4' or '5' or '6' or '7' or '8' or '9' %}{% assign invoice_digits = invoice_digits | append: c %}{% endcase %}{% endfor %}
{% assign invoice_nr = 'RE-' | append: invoice_digits %}
{% assign packing_slip_nr = invoice_nr | append: '-1' %}

<div style="margin: 0 0 1.5em 0; padding: 1.5em; border: 1px solid #ddd;">
  <div style="float: left; width: 50%;">
    {% assign preferred_logo_url = 'https://cdn.shopify.com/s/files/1/0957/1690/1239/files/Rollladenwelt_logo_insektenschutz_kurz_shopify_header_800px.png?v=1773233424' %}
    {% assign logo_url = preferred_logo_url %}
    {% if logo_url == blank %}
      {% assign logo_url = shop.email_logo_url %}
      {% if logo_url == blank and shop.brand and shop.brand.logo %}
        {% assign brand_logo = shop.brand.logo %}
        {% if brand_logo.src != blank %}
          {% assign logo_url = brand_logo.src %}
        {% else %}
          {% assign logo_url = brand_logo | image_url: width: 440 %}
        {% endif %}
      {% endif %}
      {% if logo_url == blank and shop.brand and shop.brand.square_logo %}
        {% assign brand_square = shop.brand.square_logo %}
        {% if brand_square.src != blank %}
          {% assign logo_url = brand_square.src %}
        {% else %}
          {% assign logo_url = brand_square | image_url: width: 440 %}
        {% endif %}
      {% endif %}
    {% endif %}
    {% if logo_url != blank %}
      <img src="{{ logo_url }}" alt="" style="max-width: 220px; max-height: 70px; object-fit: contain; margin-bottom: 10px;">
      <br>
    {% endif %}
    <strong>{{ shop.name }}</strong><br>
    {{ shop.address.street }}<br>
    {{ shop.address.zip }} {{ shop.address.city }}<br>
    {{ shop.address.country }}
  </div>
  <div style="float: right; width: 50%; text-align: right;">
    <h2 style="margin: 0;">Lieferschein</h2>
    <table style="width: 100%; margin-top: 10px; font-size: 0.95em;">
      <tr><td style="text-align: right; padding: 2px 0;">Lieferschein-Nr.:</td><td style="text-align: right; padding: 2px 0;"><strong>{{ packing_slip_nr }}</strong></td></tr>
      <tr><td style="text-align: right; padding: 2px 0;">Rechnungs-Nr.:</td><td style="text-align: right; padding: 2px 0;"><strong>{{ invoice_nr }}</strong></td></tr>
      <tr><td style="text-align: right; padding: 2px 0;">Datum:</td><td style="text-align: right; padding: 2px 0;">{{ created_at | date: "%d.%m.%Y" }}</td></tr>
      <tr><td style="text-align: right; padding: 2px 0;">Bestellung:</td><td style="text-align: right; padding: 2px 0;">{{ order_name }}</td></tr>
      <tr><td style="text-align: right; padding: 2px 0;">Kommission:</td><td style="text-align: right; padding: 2px 0;">{{ order.attributes.Kommission | default: order.attributes.Projekt | default: '-' }}</td></tr>
    </table>
  </div>
  <div style="clear: both;"></div>
</div>

<style>
  .pickbox { display: inline-block; width: 14px; height: 14px; border: 1.5px solid #000; }
</style>

<div style="margin: 0 0 1.5em 0;">
  <div style="float: left; width: 50%;">
    <strong>Versand an</strong><br>
    {% if shipping_address %}
      {{ shipping_address.name }}<br>
      {% if shipping_address.company != blank %}{{ shipping_address.company }}<br>{% endif %}
      {{ shipping_address.street }}<br>
      {{ shipping_address.zip }} {{ shipping_address.city }}<br>
      {{ shipping_address.country }}
    {% else %}
      {{ billing_address.name }}<br>
      {% if billing_address.company != blank %}{{ billing_address.company }}<br>{% endif %}
      {{ billing_address.street }}<br>
      {{ billing_address.zip }} {{ billing_address.city }}<br>
      {{ billing_address.country }}
    {% endif %}
  </div>
  <div style="float: right; width: 50%; text-align: right;">
    {% if order.note != blank %}
      <strong>Hinweis</strong><br>
      <div style="white-space: pre-wrap;">{{ order.note }}</div>
    {% endif %}
  </div>
  <div style="clear: both;"></div>
</div>

<table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
  <thead>
    <tr style="border-bottom: 2px solid #000;">
      <th style="text-align: left; padding: 8px;">Menge</th>
      <th style="text-align: left; padding: 8px;">Artikel</th>
      <th style="text-align: center; padding: 8px; width: 28px;">OK</th>
    </tr>
  </thead>
  <tbody>
    {% assign order_panzer_anzahl = '' %}
    {% if order.metafields.custom.panzer_anzahl and order.metafields.custom.panzer_anzahl.value != blank %}
      {% assign order_panzer_anzahl = order.metafields.custom.panzer_anzahl.value %}
    {% endif %}

    {% assign merged_keys = '' %}
    {% for line_item in line_items %}
      {% assign is_custom_roller = false %}
      {% assign roller_config = '' %}
      {% assign roller_endleiste = '' %}
      {% assign roller_weight = '' %}
      {% assign roller_project = '' %}
      {% assign roller_count = '' %}

      {% for property in line_item.properties %}
        {% if property.first == '_Kalkulation_Typ' and property.last == 'Maßanfertigung' %}
          {% assign is_custom_roller = true %}
        {% endif %}
        {% if property.first == 'Konfiguration' and property.last != blank %}
          {% assign is_custom_roller = true %}
          {% assign roller_config = property.last %}
        {% endif %}
        {% if property.first == 'Endleiste' and property.last != blank %}
          {% assign roller_endleiste = property.last %}
        {% endif %}
        {% if property.first == 'Gewicht (ca.)' and property.last != blank %}
          {% assign roller_weight = property.last %}
        {% endif %}
        {% if property.first == 'Projekt' and property.last != blank %}
          {% assign roller_project = property.last %}
        {% endif %}
        {% if property.first == '_Anzahl_Rolllaeden' and property.last != blank %}
          {% assign roller_count = property.last %}
        {% endif %}
      {% endfor %}

      {% assign qty_to_show = line_item.quantity %}
      {% if is_custom_roller %}
        {% assign panzer_anzahl_to_show = roller_count | default: order_panzer_anzahl %}
        {% assign qty_to_show = panzer_anzahl_to_show | plus: 0 %}
        {% if qty_to_show <= 0 %}
          {% assign qty_to_show = 1 %}
        {% endif %}
      {% endif %}

      {% if is_custom_roller %}
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 8px; vertical-align: top;">{{ qty_to_show }}</td>
          <td style="padding: 8px; vertical-align: top;">
            <strong>{{ line_item.title }}</strong>
            <div style="font-size: 0.9em; color: #555; margin-top: 4px;">
              {% if roller_project != blank %}<div>• Projekt: {{ roller_project }}</div>{% endif %}
              {% if roller_config != blank %}<div>• {{ roller_config }}</div>{% endif %}
              {% if roller_endleiste != blank %}<div>• Endleiste: {{ roller_endleiste }}</div>{% endif %}
              {% if roller_weight != blank %}<div>• Gewicht: {{ roller_weight }}</div>{% endif %}
            </div>
          </td>
          <td style="padding: 8px; vertical-align: top; text-align: center;"><span class="pickbox"></span></td>
        </tr>
      {% else %}
        {% assign merge_group = '' %}
        {% assign separate_flag = false %}
        {% for p in line_item.properties %}
          {% if p.first == '_Zubehoer_separat' and p.last == 'Ja' %}
            {% assign separate_flag = true %}
          {% endif %}
          {% if p.first == 'Projekt' and p.last != blank %}
            {% assign merge_group = p.last %}
          {% endif %}
        {% endfor %}
        {% if separate_flag == false %}
          {% assign merge_group = '' %}
        {% endif %}
        {% assign key = line_item.title | append: '||' | append: line_item.sku | append: '||' | append: merge_group %}
        {% assign needle = key | append: '|||' %}
        {% unless merged_keys contains needle %}
          {% assign merged_keys = merged_keys | append: needle %}
          {% assign merged_qty = 0 %}
          {% for li2 in line_items %}
            {% assign li2_is_custom = false %}
            {% for p2 in li2.properties %}
              {% if p2.first == '_Kalkulation_Typ' and p2.last == 'Maßanfertigung' %}
                {% assign li2_is_custom = true %}
              {% endif %}
            {% endfor %}
            {% unless li2_is_custom %}
              {% assign li2_group = '' %}
              {% assign li2_sep = false %}
              {% for p3 in li2.properties %}
                {% if p3.first == '_Zubehoer_separat' and p3.last == 'Ja' %}
                  {% assign li2_sep = true %}
                {% endif %}
                {% if p3.first == 'Projekt' and p3.last != blank %}
                  {% assign li2_group = p3.last %}
                {% endif %}
              {% endfor %}
              {% if li2_sep == false %}
                {% assign li2_group = '' %}
              {% endif %}
              {% if li2.title == line_item.title and li2.sku == line_item.sku and li2_group == merge_group %}
                {% assign merged_qty = merged_qty | plus: li2.quantity %}
              {% endif %}
            {% endunless %}
          {% endfor %}
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px; vertical-align: top;">{{ merged_qty }}</td>
            <td style="padding: 8px; vertical-align: top;">
              <strong>{{ line_item.title }}</strong>
              {% if line_item.sku != blank %}
                <div style="font-size: 0.9em; color: #555;">Art.-Nr.: {{ line_item.sku }}</div>
              {% endif %}
            </td>
            <td style="padding: 8px; vertical-align: top; text-align: center;"><span class="pickbox"></span></td>
          </tr>
        {% endunless %}
      {% endif %}
    {% endfor %}
  </tbody>
</table>

<div style="background:#f5f7fa; border:1px solid #d7dde5; padding:15px; margin:20px 0 25px 0;">
  <h3 style="margin:0 0 10px 0; font-size:1.05em;">📌 Rechnungsdaten</h3>
  <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap: 5px 25px; font-size:0.95em;">
    <div style="display:flex; justify-content:space-between;"><span>Rechnungs-Nr.:</span><strong>{{ invoice_nr }}</strong></div>
    <div style="display:flex; justify-content:space-between;"><span>Lieferschein-Nr.:</span><strong>{{ packing_slip_nr }}</strong></div>
    <div style="display:flex; justify-content:space-between;"><span>Rechnungsdatum:</span><strong>{{ created_at | date: "%d.%m.%Y" }}</strong></div>
    <div style="display:flex; justify-content:space-between;"><span>Zahlungsziel:</span><strong>14 Tage netto</strong></div>
    <div style="display:flex; justify-content:space-between;"><span>Gesamtbetrag:</span><strong style="font-size:1.1em;">{{ order.total_price | money }}</strong></div>
    <div style="display:flex; justify-content:space-between;"><span>Shopify Bestellung:</span><strong>{{ order_name }}</strong></div>
  </div>
</div>

{% if order.fulfillments and order.fulfillments.size > 0 %}
  {% assign first_fulfillment = order.fulfillments.first %}
  {% if first_fulfillment.tracking_number != blank %}
    <div style="margin-bottom: 25px;">
      <strong>🚚 Sendungsverfolgung ({{ first_fulfillment.tracking_company | default: 'DHL' }}):</strong><br>
      <a href="{{ first_fulfillment.tracking_url }}" style="font-weight:bold;">#{{ first_fulfillment.tracking_number }}</a>
    </div>
  {% endif %}
{% endif %}

<div style="margin-top:40px;">
  <div style="float:left; width:45%;">
    <strong>Packstückanzahl:</strong> _________________
  </div>
  <div style="float:right; width:45%; text-align:right;">
    <strong>Gewicht (ca.):</strong> _________________ kg
  </div>
  <div style="clear: both;"></div>
</div>

<div style="margin-top:60px; display:grid; grid-template-columns:repeat(2,1fr); gap: 0 40px;">
  <div style="border-top:1px solid #666; padding-top:6px; text-align:center;">
    Unterschrift Absender / Versand
  </div>
  <div style="border-top:1px solid #666; padding-top:6px; text-align:center;">
    Unterschrift Empfänger / Datum: _______________
  </div>
</div>
<div style="clear: both;"></div>
